# Binaries
/prism
/prism-*
!/prism-position.md
*.exe
*.test

# Build output
/dist/
/bin/

# Go
*.o
*.a
vendor/

# Grove index (generated, per-repo)
.grove/

# ONNX model cache
~/.prism/models/

# VS Code extension build output
vscode-extension/out/
vscode-extension/node_modules/
vscode-extension/*.vsix

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Provasign (paused) — local daemon state only, not tracked
.provasign/

# Build artifacts
/coverage.out
/.cache/
__pycache__/

# Benchmark harness output under docs/research: keep the REPORT and scripts,
# not the run output (it belongs in the research repo, and it floods search).
docs/research/*/results/
docs/research/*/transcripts/
docs/research/*/cells/
docs/research/*/raw-cells/
docs/research/*/plan-outputs/
docs/research/*/prism-candidate
docs/research/*/*.gz
docs/research/*/*.snapshot
